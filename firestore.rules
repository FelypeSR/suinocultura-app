rules_version = '2';

// Regras de segurança do Firestore — projeto "suinobd" (GSPR).
//
// Modelo multi-granja: os dados do rebanho vivem em subcoleções de
// granjas/{granjaId}, e só os e-mails listados no array `membros` do
// documento da granja podem lê-los/escrevê-los. Qualquer usuário logado
// pode CRIAR a própria granja (cadastro aberto), mas nunca enxerga a de
// outra pessoa. Tudo o que não estiver explicitamente liberado é bloqueado.
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuário autenticado em qualquer provedor (e-mail/senha ou Google).
    function isSignedIn() {
      return request.auth != null;
    }

    // E-mail do usuário logado, normalizado para minúsculas (é assim que os
    // membros ficam gravados no documento da granja).
    function emailLogado() {
      return request.auth.token.email.lower();
    }

    // O usuário logado é membro da granja? Usado pelas subcoleções, que
    // precisam buscar o documento pai (1 leitura extra, com cache por
    // request — padrão recomendado pelo Firebase).
    function membroDe(granjaId) {
      return isSignedIn()
        && emailLogado() in
           get(/databases/$(database)/documents/granjas/$(granjaId)).data.membros;
    }

    match /granjas/{granjaId} {
      // Leitura direta no documento: `resource` já está carregado, não
      // precisa de get(). Cobre também a query "minhas granjas"
      // (where membros array-contains meuEmail).
      allow read: if isSignedIn() && emailLogado() in resource.data.membros;

      // Criar granja: aberto a qualquer logado, desde que ele mesmo seja o
      // dono e esteja entre os membros.
      allow create: if isSignedIn()
        && request.resource.data.dono == emailLogado()
        && emailLogado() in request.resource.data.membros;

      // Atualizar (renomear, convidar/remover membros): qualquer membro,
      // mas o dono não pode ser trocado nem removido dos membros.
      allow update: if isSignedIn()
        && emailLogado() in resource.data.membros
        && request.resource.data.dono == resource.data.dono
        && request.resource.data.dono in request.resource.data.membros;

      // Excluir a granja: só o dono.
      allow delete: if isSignedIn() && resource.data.dono == emailLogado();

      // ---- Dados do rebanho (subcoleções) ----

      match /animais/{animalId} {
        allow read, write: if membroDe(granjaId);

        // Histórico de coberturas do reprodutor. O match do documento acima
        // NÃO alcança subcoleções, então precisa ser explícito.
        match /coberturas/{coberturaId} {
          allow read, write: if membroDe(granjaId);
        }
      }

      match /racoes/{racaoId} {
        allow read, write: if membroDe(granjaId);
      }

      match /eventos/{eventoId} {
        allow read, write: if membroDe(granjaId);
      }

      match /ninhadas/{ninhadaId} {
        allow read, write: if membroDe(granjaId);
      }
    }

    // Perfil do usuário (foto etc.): cada um só escreve no próprio
    // documento; a leitura é liberada para logados (avatares).
    match /usuarios/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Negação padrão: qualquer outra coleção/documento fica bloqueado
    // (inclui as coleções antigas da raiz, mantidas como backup da
    // migração de 2026-07-09, e a antiga /autorizados).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}